# Copy to .env. docker compose reads it for the coordinator (which hosts Discord);
# the Watcher (host) reads the same keys from your shell (e.g. `set -a; . ./.env; set +a`).
# After reorganizing this file, run `bun run env:sync` to re-lay your .env to match it.

# ---------------------------------------------------------------------------
# Coordinator
# ---------------------------------------------------------------------------
PORT=8080
# REQUIRED: the Coordinator refuses to start without it. Channel Adapters (Discord, in this
# process or apps/discord-gateway) send it on /inbound, /commands and /prompts/answer.
# `openssl rand -base64 32`.
COORDINATOR_SERVICE_TOKEN=
# Where browsers reach the Coordinator (connect links + OAuth callbacks). Registered workers
# also register and poll here, so it must be reachable from their machines.
PUBLIC_URL=http://localhost:8080
# Origins a browser may call the API from, comma-separated, when the web dashboard is served
# from another origin. Empty: no CORS (locally Vite proxies /api). `alchemy deploy` sets it to
# the dashboard URL itself. The first one is where Google sign-in returns to, so set it
# (http://localhost:5173 for `bun run dev`) to sign in to the dashboard with Google.
# WEB_ORIGIN=
# Host runs store SQLite in <repo>/.data/ by default. Override only if needed (a relative
# path resolves against the repo root). In Compose these are forced under the /data volume.
# DATABASE_PATH=.data/project-os.sqlite
# PI_STORAGE_PATH=.data/pi-durable.sqlite
# `bun run seed`; in Compose pass these with -e (see README).
SEED_PROJECT_NAME=Demo Project
SEED_DISCORD_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Agent runtime (Pi Durable + Jev), see packages/agent-runtime
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
CHAT_MODEL_PROVIDER=openrouter
# REQUIRED: the Coordinator refuses to start without it (any OpenRouter model id).
CHAT_MODEL_ID=anthropic/claude-sonnet-4.5
JEV_MODEL_ID=typesafe/jev-1.14
INTENT_CONFIDENCE_THRESHOLD=0.5
# Optional: export Pi Durable traces + metrics over OTLP/HTTP. Unset = telemetry off.
# Standard OTEL_* vars apply (OTEL_EXPORTER_OTLP_HEADERS, OTEL_SERVICE_NAME, ...).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Discord runs inside the Coordinator when the token is set. Leave it empty to run without Discord.
DISCORD_BOT_TOKEN=
# Server where admin `create project` makes each project's channel. The bot needs the
# Manage Channels permission there. Optional category to put project channels under.
DISCORD_GUILD_ID=
DISCORD_PROJECT_CATEGORY_ID=
# Admin create_project also creates the project's Discord channel (set false to only link
# existing channels). Needs DISCORD_GUILD_ID and the bot's Manage Channels permission.
DISCORD_PROJECT_CHANNEL_AUTO_CREATE=true
# Admin channel. Only these user ids (comma-separated) may use it; empty = nobody.
# Also where /project-create works (Discord reads ADMIN_CHANNEL_ID too).
ADMIN_CHANNEL_ID=
ADMIN_USER_IDS=
# Optional: only people holding at least one of these role ids (comma-separated) can trigger
# the bot, by message or slash command; others are ignored. Empty = everyone in the server.
# ADMIN_USER_IDS always pass.
# The bot never answers DMs.
DISCORD_MEMBER_ROLE_IDS=
# Project channels: the Coordinator ignores top-level messages that don't @mention the bot.
# Threads and the admin channel don't need a mention. Set false to answer every message.
DISCORD_REQUIRE_MENTION=true
# Only for Discord in a separate process (a Cloudflare Coordinator, or a split self-host).
# On Cloudflare, `bun run deploy` runs the gateway as a Container when DISCORD_BOT_TOKEN and PUBLIC_URL
# are set; set DISCORD_SPLIT_GATEWAY_URL instead to run it yourself and skip the Container.
# When DISCORD_SPLIT_GATEWAY_URL is set, the Coordinator ignores DISCORD_BOT_TOKEN and posts replies
# there. Run Discord alone with `bun run --cwd apps/discord-gateway start`, which
# listens on DISCORD_SPLIT_GATEWAY_PORT and forwards to COORDINATOR_URL with
# COORDINATOR_SERVICE_TOKEN. In Compose:
# `docker compose --profile split up` with DISCORD_SPLIT_GATEWAY_URL=http://discord-gateway:8081.
# DISCORD_SPLIT_GATEWAY_URL=http://localhost:8081
# DISCORD_SPLIT_GATEWAY_PORT=8081
# COORDINATOR_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Sign-in and account linking (Better Auth)
# ---------------------------------------------------------------------------
# REQUIRED: the Coordinator refuses to start without it. Signs dashboard sessions and encrypts
# stored OAuth tokens: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# The dashboard operator, created on first start (password at least 8 characters). Sign-up is
# off, so without it nobody can sign in to the dashboard.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# More emails allowed to use the dashboard, comma-separated (ADMIN_EMAIL always is).
# ADMIN_EMAILS=
# People link their own Google / GitHub / ClickUp with /connect, and Workers use that person's token.
# Off unless at least one client below is set. Callbacks are served at PUBLIC_URL.
# Google OAuth web client. Redirect URIs: $PUBLIC_URL/api/auth/callback/google (linking) and
# $PUBLIC_URL/api/auth/callback/google-signin (dashboard sign-in, with WEB_ORIGIN set).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub App (not an OAuth App); callback URL: $PUBLIC_URL/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# ClickUp app (Settings > Apps); redirect URL: $PUBLIC_URL/api/auth/callback/clickup.
# For task attachments too big for Discord: the PM links the ClickUp task and the Worker reads
# the file with that PM's own ClickUp token.
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Workers: Watcher on your own computer (host; points at the published Coordinator port)
# ---------------------------------------------------------------------------
MCP_URL=http://localhost:8080/mcp
POLL_INTERVAL_MS=300000
MAX_SESSIONS=1
WORKER_CWD=

# ---------------------------------------------------------------------------
# Workers: registered computers (/register-worker)
# ---------------------------------------------------------------------------
# Computers running the Watcher. A personal one gets only its owner's tickets; a shared one
# (an admin's `/register-worker shared:True`, in the admin channel) gets anyone's. They register
# and poll at PUBLIC_URL. A new ticket goes to the requester's online computer, else a free
# shared one, else a sandbox from the pool below; with none free it is queued and the health
# sweep assigns it once one has room.
# Tickets one shared computer holds at once before the next goes elsewhere (match its MAX_SESSIONS).
# SHARED_WORKER_MAX_TICKETS=1
# How people install the Watcher (default: bun install -g @project-os/watcher).
# WATCHER_INSTALL_COMMAND=

# ---------------------------------------------------------------------------
# Workers: cloud sandbox pool (optional)
# ---------------------------------------------------------------------------
# The Coordinator starts a Pi session per ticket in a cloud sandbox. Each ticket gets its own
# worker id (<provider>-<ticketId>, e.g. daytona-<id>); no Watcher ever sees them. A provider
# joins the pool when its credentials below are set. See SETUP.md §6.
#
# Which providers, in the order to try them: daytona, cloudflare, boat.
# Unset: every configured provider, in that order. A ticket goes to the first one with room
# (see *_MAX_CONCURRENT). Free shared workers (above) are tried first; with nothing free the
# ticket waits, queued, until something has room.
# WORKER_PROVIDERS=cloudflare,daytona,boat
# REQUIRED with any provider: the Coordinator /mcp URL reachable from the sandbox's cloud
# (a tunnel, e.g. https://abc.trycloudflare.com/mcp). localhost won't work.
SANDBOX_MCP_URL=
# Pi model pattern; defaults to openrouter/$CHAT_MODEL_ID. Reuses OPENROUTER_API_KEY.
# SANDBOX_PI_MODEL=
# SANDBOX_SESSION_TIMEOUT_SECONDS=1800
# (DAYTONA_MCP_URL / DAYTONA_PI_MODEL / DAYTONA_SESSION_TIMEOUT_SECONDS still work as fallbacks.)

# --- Daytona: an API key from app.daytona.io.
DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# Snapshot with Node >= 22.19 (Pi installs itself at session start); default snapshot if unset.
# DAYTONA_SNAPSHOT=
# DAYTONA_MAX_CONCURRENT=

# --- boat.dev: an API key (boat api-key create project-os --preset ci); keys start with boat_.
BOAT_API_KEY=
# BOAT_API_URL=https://boat.dev/api/v1
# small | default | large | xlarge (unset: your account default)
# BOAT_SANDBOX_SIZE=
# Keep at or below your plan's sandboxes-at-once limit.
# BOAT_MAX_CONCURRENT=

# --- Cloudflare Sandbox: the bridge Worker in apps/cloudflare-sandbox (deploy it first) and the
# BRIDGE_TOKEN secret you gave it.
CLOUDFLARE_SANDBOX_URL=
CLOUDFLARE_SANDBOX_TOKEN=
# Match the bridge's containers.max_instances (5 in its wrangler.jsonc).
# CLOUDFLARE_SANDBOX_MAX_CONCURRENT=5

# `bun run dev:cf` serves each Worker on its own port so they don't take each other's. Set these
# per checkout when running several at once; a taken port falls back to the next free one.
# COORDINATOR_DEV_PORT=8787
# DASHBOARD_DEV_PORT=8788
# DISCORD_GATEWAY_DEV_PORT=8789
