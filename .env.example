# Coordinator
PORT=8080
DATABASE_PATH=./project-os.sqlite
# Agent runtime (Pi Durable + Jev), see packages/agent-runtime
OPENROUTER_API_KEY=
PI_STORAGE_PATH=./pi-durable.sqlite
CHAT_MODEL_PROVIDER=openrouter
CHAT_MODEL_ID=
JEV_MODEL_ID=typesafe/jev-1.14
INTENT_CONFIDENCE_THRESHOLD=0.5

# Discord adapter
DISCORD_TOKEN=
COORDINATOR_URL=http://localhost:8080

# Watcher (host)
MCP_URL=http://localhost:8080/mcp
WORKER_ID=local-claude
POLL_INTERVAL_MS=300000
MAX_SESSIONS=1
WORKER_CWD=
