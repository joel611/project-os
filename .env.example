# Copy to .env. docker compose reads it for the coordinator (which hosts Discord);
# the Watcher (host) reads the same keys from your shell (e.g. `set -a; . ./.env; set +a`).

# Coordinator
PORT=8080
# Host runs store SQLite in <repo>/.data/ by default. Override only if needed (a relative
# path resolves against the repo root). In Compose these are forced under the /data volume.
# DATABASE_PATH=.data/project-os.sqlite
# PI_STORAGE_PATH=.data/pi-durable.sqlite
# Admin channel (Discord). Only these user ids (comma-separated) may use it; empty = nobody.
# Also where /project-create works (Discord reads ADMIN_CHANNEL_ID too).
ADMIN_CHANNEL_ID=
ADMIN_USER_IDS=
# Project channels: the Coordinator ignores top-level messages that don't @mention the bot.
# Threads and the admin channel don't need a mention. Set false to answer every message.
DISCORD_REQUIRE_MENTION=true
# `bun run seed`; in Compose pass these with -e (see README).
SEED_PROJECT_NAME=Demo Project
SEED_DISCORD_CHANNEL_ID=
# Agent runtime (Pi Durable + Jev), see packages/agent-runtime
OPENROUTER_API_KEY=
CHAT_MODEL_PROVIDER=openrouter
# REQUIRED: the Coordinator refuses to start without it (any OpenRouter model id).
CHAT_MODEL_ID=anthropic/claude-sonnet-4.5
JEV_MODEL_ID=typesafe/jev-1.14
INTENT_CONFIDENCE_THRESHOLD=0.5
# Optional: export Pi Durable traces + metrics over OTLP/HTTP. Unset = telemetry off.
# Standard OTEL_* vars apply (OTEL_EXPORTER_OTLP_HEADERS, OTEL_SERVICE_NAME, ...).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Shared by Coordinator (assigns tickets to it) and Watcher (polls as it). Must match.
WORKER_ID=local-claude-1

# Discord runs inside the Coordinator when the token is set. Leave it empty to run without Discord.
DISCORD_BOT_TOKEN=
# Server where admin `create project` makes each project's channel. The bot needs the
# Manage Channels permission there. Optional category to put project channels under.
DISCORD_GUILD_ID=
DISCORD_PROJECT_CATEGORY_ID=
# Admin create_project also creates the project's Discord channel (set false to only link
# existing channels). Needs DISCORD_GUILD_ID and the bot's Manage Channels permission.
DISCORD_PROJECT_CHANNEL_AUTO_CREATE=true
# Optional: only people holding at least one of these role ids (comma-separated) can trigger
# the bot, by message or slash command; others are ignored. Empty = everyone in the server.
# ADMIN_USER_IDS always pass.
# The bot never answers DMs.
DISCORD_MEMBER_ROLE_IDS=
# Only for Discord in a separate process (a Cloudflare Coordinator, or a split self-host).
# When DISCORD_SPLIT_ADAPTER_URL is set, the Coordinator ignores DISCORD_BOT_TOKEN and posts replies
# there. Run Discord alone with `bun run --cwd packages/channel-discord standalone`, which
# listens on DISCORD_ADAPTER_PORT and forwards to COORDINATOR_URL. In Compose:
# `docker compose --profile split up` with DISCORD_SPLIT_ADAPTER_URL=http://discord:8081.
# DISCORD_SPLIT_ADAPTER_URL=http://localhost:8081
# DISCORD_ADAPTER_PORT=8081
# COORDINATOR_URL=http://localhost:8080

# Watcher (host; points at the published Coordinator port)
MCP_URL=http://localhost:8080/mcp
POLL_INTERVAL_MS=300000
MAX_SESSIONS=1
WORKER_CWD=

# Account linking (/connect): people link their own Google / GitHub, and Workers use that
# person's token. Off unless BETTER_AUTH_SECRET and at least one client are set.
# Secret signs cookies and encrypts stored tokens: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Where browsers reach the Coordinator (connect links + OAuth callbacks).
PUBLIC_URL=http://localhost:8080
# Google OAuth web client; redirect URI: $PUBLIC_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub App (not an OAuth App); callback URL: $PUBLIC_URL/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Daytona worker (optional): set DAYTONA_API_KEY to run `daytona_pi` tickets in a sandbox.
# Each ticket gets its own worker id (daytona-<ticketId>); the host Watcher never sees them.
DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# Snapshot with Node >= 22.19 (Pi installs itself at session start); default snapshot if unset.
# DAYTONA_SNAPSHOT=
# REQUIRED with DAYTONA_API_KEY: the Coordinator /mcp URL reachable from Daytona's cloud
# (a tunnel, e.g. https://abc.trycloudflare.com/mcp). localhost won't work.
DAYTONA_MCP_URL=
# Pi model pattern; defaults to openrouter/$CHAT_MODEL_ID. Reuses OPENROUTER_API_KEY.
# DAYTONA_PI_MODEL=
# DAYTONA_SESSION_TIMEOUT_SECONDS=1800

# Personal workers (/register-worker): people's own computers run the Watcher and get only
# their own tickets. They register and poll at PUBLIC_URL, so it must reach the Coordinator
# from their machines. Tickets from anyone without an online computer go to the shared worker:
# DEFAULT_WORKER_TYPE, which defaults to daytona_pi when DAYTONA_API_KEY is set.
# DEFAULT_WORKER_TYPE=daytona_pi
# How people install the Watcher (default: bun install -g @project-os/watcher).
# WATCHER_INSTALL_COMMAND=
