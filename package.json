{
  "name": "project-os",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "libs/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run --parallel -r dev",
    "dev:cf": "alchemy dev",
    "deploy": "alchemy deploy",
    "plan": "alchemy plan",
    "destroy": "alchemy destroy",
    "env:sync": "bun scripts/sync-env.ts",
    "env:gh": "bun scripts/gh-env.ts",
    "seed": "bun apps/coordinator/src/main.seed.ts",
    "build": "vp run -r build",
    "prepare": "vp config",
    "check": "vp check",
    "fix": "vp check --fix",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "bun --bun vp test",
    "test:run": "bun --bun vp test run",
    "test:coverage": "bun --bun vp test run --coverage",
    "test:integration": "bun --bun vp test run apps/e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web --noEmit && tsc -p apps/cloudflare-sandbox --noEmit && tsc -p apps/discord-gateway --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@types/bun": "1.4.4",
    "@vitest/coverage-v8": "5.0.5",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "typescript": "^5.9.3",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "packageManager": "bun@1.4.4"
}
